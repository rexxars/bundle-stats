{
  "name": "@rexxars/bundle-stats",
  "version": "2.0.0",
  "description": "Measure and compare ESM bundle scenarios with Rolldown",
  "license": "MIT",
  "author": "Espen Hovlandsdal <espen@hovlandsdal.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rexxars/bundle-stats.git"
  },
  "bugs": {
    "url": "https://github.com/rexxars/bundle-stats/issues"
  },
  "homepage": "https://github.com/rexxars/bundle-stats#readme",
  "bin": {
    "bundle-stats": "bin/bundle-stats.js"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin/bundle-stats.js"
  ],
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test 'src/**/*.test.ts'",
    "knip": "knip",
    "build:viewer": "node scripts/build-viewer.ts",
    "prepublishOnly": "tsdown"
  },
  "dependencies": {
    "rolldown": "^1.2.5",
    "rollup-plugin-visualizer": "^5.14.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.28.0",
    "knip": "^5.85.0",
    "prettier": "^3.5.3",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.33.0"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  }
}
